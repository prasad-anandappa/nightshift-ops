# NightShift Ops — environment template (copy to .env; NEVER commit .env)
# Vultr Serverless Inference (OpenAI-compatible) — REQUIRED for Challenge 1
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Model ID picked from the account catalog at kickoff smoke test (DESIGN §6)
VULTR_INFERENCE_MODEL=
# Vultr API (optional: throwaway sandbox instances / snapshot rebuilds)
VULTR_API_KEY=
# Managed PostgreSQL (agent memory + audit store)
DATABASE_URL=
# Object Storage (incident reports, log snapshots, demo assets)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=nightshift-ops
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Sandbox target (disposable instance; agent credentials reach ONLY here)
SANDBOX_HOST=
SANDBOX_SSH_USER=root
# Agent behaviour
KILL_SWITCH_FILE=/tmp/nightshift-stop
