# NightShift Ops — environment template (copy to .env; NEVER commit .env)
# Vultr Serverless Inference (OpenAI-compatible) — REQUIRED for Challenge 1
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Model IDs — picked from the account catalog by smoke test (Nov 7, 2026).
# Any chat model from `GET /v1/models` on the inference endpoint works.
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
VULTR_INFERENCE_FALLBACK_MODEL=qwen3.8-flash-next
# Local state (SQLite store + incident reports)
NIGHTSHIFT_DB=/opt/nightshift/nightshift.db
NIGHTSHIFT_REPORTS=/opt/nightshift/reports
# Sandbox target (the agent reaches ONLY this container / URL)
SANDBOX_CONTAINER=nightshift-shopfront
SANDBOX_SERVICE_URL=http://127.0.0.1:8081
# Agent behaviour
KILL_SWITCH_FILE=/tmp/nightshift-stop
PROBE_INTERVAL_S=2
PROBE_FAILURE_THRESHOLD=2
